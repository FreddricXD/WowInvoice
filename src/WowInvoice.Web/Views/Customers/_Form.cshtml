@model CustomerFormViewModel

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label required-label"></label>
        <input asp-for="Name" class="form-control" maxlength="120" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label required-label"></label>
        <input asp-for="Email" class="form-control" maxlength="160" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control input-phone" type="text" inputmode="tel" maxlength="30" autocomplete="tel" data-val-phoneonly="true" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Company" class="form-label"></label>
        <input asp-for="Company" class="form-control" maxlength="200" />
        <span asp-validation-for="Company" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" class="form-control" rows="2" maxlength="300"></textarea>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
</div>
