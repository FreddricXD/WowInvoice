@model IEnumerable<WowInvoice.Web.Controllers.CustomerListItemViewModel>
@{
    ViewData["Title"] = "Customers";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1>Customers</h1>
        <p class="text-muted mb-0">Manage your client directory</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ New Customer</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-6">
        <input type="search" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by name, email, or company..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="empty-state">
        <h3>No customers yet</h3>
        <p>Add your first customer to start creating invoices.</p>
        <a asp-action="Create" class="btn btn-primary">Add Customer</a>
    </div>
}
else
{
    <div class="table-responsive card shadow-sm">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Company</th>
                    <th>Invoices</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model)
                {
                    <tr>
                        <td><strong>@customer.Name</strong></td>
                        <td>@customer.Email</td>
                        <td>@(customer.Company ?? "—")</td>
                        <td><span class="badge bg-secondary">@customer.InvoiceCount</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary">View</a>
                            <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
