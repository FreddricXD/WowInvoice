<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WowInvoice</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="brand-logo">WI</div>
                <span class="brand-text">WowInvoice</span>
            </div>
            <nav class="sidebar-nav">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Index">
                    <span class="nav-icon">&#9632;</span> Dashboard
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Invoices" ? "active" : "")"
                   asp-controller="Invoices" asp-action="Index">
                    <span class="nav-icon">&#9998;</span> Invoices
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")"
                   asp-controller="Customers" asp-action="Index">
                    <span class="nav-icon">&#9786;</span> Customers
                </a>
            </nav>
            <div class="sidebar-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary w-100" id="theme-toggle" aria-label="Toggle dark mode">
                    Toggle Theme
                </button>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="user-info mt-3">
                        <div class="user-name">@User.Identity.Name</div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">Sign Out</button>
                    </form>
                }
            </div>
        </aside>

        <div class="main-content">
            <header class="topbar d-lg-none">
                <button class="btn btn-outline-secondary btn-sm" id="sidebar-toggle" aria-label="Toggle menu">Menu</button>
                <span class="fw-bold">WowInvoice</span>
            </header>
            <main class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="sidebar-overlay" id="sidebar-overlay"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
